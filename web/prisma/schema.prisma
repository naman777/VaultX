generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model user {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  files     file[]
  folders   folder[]  // A user can have multiple folders
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model folder {
  id         String     @id @default(uuid())
  name       String
  user_id    String
  user       user       @relation(fields: [user_id], references: [id])
  parent_id  String?    // For nested folders
  parent     folder?    @relation("FolderHierarchy", fields: [parent_id], references: [id])
  children   folder[]   @relation("FolderHierarchy")
  files      file[]     // Files inside this folder
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model file {
  id         String    @id @default(uuid())
  name       String
  url        String
  user_id    String
  user       user      @relation(fields: [user_id], references: [id])
  folder_id  String?   // Optional: null means file is in root
  folder     folder?   @relation(fields: [folder_id], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// Anonymous file sharing: anyone can upload with a custom unique name
model shared_file {
  id          String   @id @default(uuid())
  slug        String   @unique  // user-chosen unique name (e.g. "my-report")
  storage_key String            // actual key in R2 bucket
  original_name String          // original filename with extension
  mime_type   String
  size        Int
  createdAt   DateTime @default(now())
}